{
  "expo": {
    "name": "CampusBook",
    "slug": "campusbook",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "campusbook",
    "splash": {
      "backgroundColor": "#0034AC",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kekxcodex.campusbook"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0034AC"
      },
      "package": "com.kekxcodex.campusbook"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store"
    ]
  }
}
