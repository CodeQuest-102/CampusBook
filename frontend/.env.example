# CampusBook frontend environment variables (Expo).
# Copy to `.env`. Expo inlines EXPO_PUBLIC_* vars at build/start time.

# Backend base URL. Leave unset to use the platform default
# (localhost:8080 on iOS simulator / web, 10.0.2.2:8080 on Android emulator).
# For a physical device, set your Mac's LAN IP:
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8080
