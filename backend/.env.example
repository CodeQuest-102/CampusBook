# CampusBook backend environment variables.
# Copy to your shell/deploy environment. application.properties reads these with
# sensible dev fallbacks, so none are required for local development.

# Database
DB_URL=jdbc:postgresql://localhost:5432/campusbook
DB_USERNAME=campusbook_user
DB_PASSWORD=change-me

# JWT — MUST be overridden in any shared/prod environment.
# Minimum 32 bytes (256 bits) for the HS384 signing key.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_EXPIRATION_MS=86400000

# CORS — comma-separated allowed origins. The dev default is local Expo
# (http://localhost:8081,http://localhost:19006). Set your real hosts in
# shared/prod; the prod profile refuses to start if this is "*".
# e.g. CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Password-reset email.
# MAIL_ENABLED=false (default) logs the reset code to the console — good for local
# demos with no SMTP account. Set true and the rest to send real email.
MAIL_ENABLED=false
MAIL_FROM=CampusBook <no-reply@campusbook.local>
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Server port
SERVER_PORT=8080

# Activate production hardening (config guard, no SQL logging, docs off).
# SPRING_PROFILES_ACTIVE=prod
