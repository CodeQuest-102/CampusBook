# CampusBook backend environment variables.
# Copy to your shell/deploy environment. application.properties reads these with
# sensible dev fallbacks, so none are required for local development.

# Database
DB_URL=jdbc:postgresql://localhost:5432/campusbook
DB_USERNAME=campusbook_user
DB_PASSWORD=change-me

# JWT — MUST be overridden in any shared/prod environment.
# Minimum 32 bytes (256 bits) for the HS384 signing key.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_EXPIRATION_MS=86400000

# CORS — comma-separated allowed origins. The dev default is local Expo
# (http://localhost:8081,http://localhost:19006). Set your real hosts in
# shared/prod; the prod profile refuses to start if this is "*".
# e.g. CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Password-reset / email-verification mail.
# MAIL_ENABLED=false (default) logs the code to the console — good for local
# demos with no Brevo account. Set true and the rest to send real email, via
# Brevo's transactional email HTTP API (not SMTP — cloud hosts like Render
# commonly block outbound SMTP ports). BREVO_API_KEY comes from Brevo's
# SMTP & API settings -> "API keys & MCP" tab. MAIL_FROM must be a sender
# verified in Brevo's dashboard (Senders, Domains & Dedicated IPs -> Senders).
MAIL_ENABLED=false
MAIL_FROM=CampusBook <no-reply@campusbook.local>
BREVO_API_KEY=
BREVO_BASE_URL=https://api.brevo.com/v3

# Paystack — institution subscription payments.
# PAYSTACK_ENABLED=false (default) makes the upgrade screen use a simulated
# payment, so the flow demos with no keys. Set true and PAYSTACK_SECRET_KEY to a
# Paystack TEST secret key (sk_test_...) to take real test payments. The secret
# key stays server-side — the app never receives it. Your Paystack account must
# have GHS enabled. The callback URL is a sentinel the app intercepts in its
# checkout WebView; it needs no reachable page.
PAYSTACK_ENABLED=false
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=https://campusbook.dev/paystack/callback
# Billing email fallback for admins whose email domain Paystack rejects (e.g. the
# seeded demo admin's "@campusbook.local"). Routable admin emails are used as-is.
PAYSTACK_CUSTOMER_EMAIL=billing@campusbook.app

# Server port. Most PaaS hosts (e.g. Render) inject PORT themselves and it takes
# priority when set — SERVER_PORT is just the local-dev fallback.
SERVER_PORT=8080

# Activate production hardening (config guard, no SQL logging, docs off).
# SPRING_PROFILES_ACTIVE=prod
